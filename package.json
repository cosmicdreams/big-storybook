{
  "name": "big-storybook",
  "version": "3.0.0",
  "author": "",
  "main": "index.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@github-ui/storybook-addon-performance-panel": "^1.3.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/html-vite": "^10.6.2",
    "@storybook/test-runner": "^0.26.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "storybook": "^10.6.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "description": "Production-ready Storybook for HTML components with WebRTC screen sharing",
  "keywords": [
    "storybook",
    "webrtc",
    "screen-sharing",
    "components",
    "html"
  ],
  "license": "ISC",
  "scripts": {
    "test": "vitest",
    "test:storybook": "vitest --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint stories/**/*.js .storybook/**/*.js",
    "lint:fix": "eslint stories/**/*.js .storybook/**/*.js --fix",
    "format": "prettier --write stories/**/*.js .storybook/**/*.js css/**/*.css",
    "format:check": "prettier --check stories/**/*.js .storybook/**/*.js css/**/*.css"
  },
  "type": "module",
  "overrides": {
    "rollup": "^4.64.7",
    "axios": "^1.20.0",
    "minimatch": "^3.1.3"
  }
}
